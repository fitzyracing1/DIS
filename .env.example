# Copy to .env and fill in. Never commit real secrets or funded wallet keys.

# --- Core ---
# PORT=8080
# HOST=0.0.0.0
# DIS_CONFIG_JSON=

# --- Free on-demand /check ---
# DIS_PUBLIC_CHECK=1
# DIS_API_KEY=
# DIS_CHECK_RATE=30
# DIS_CHECK_CONCURRENCY=10
# DIS_TRUST_PROXY=1
# DIS_CHECK_ALLOW_CIDRS=

# --- Paid /check/report via x402 (USDC) ---
# Receiving wallet (EVM). Required to enable the paid route. Free /check still works without this.
DIS_X402_PAY_TO=
# CAIP-2 network or alias. Default: Base Sepolia testnet.
# Aliases: base-sepolia → eip155:84532, base → eip155:8453
DIS_X402_NETWORK=eip155:84532
# Dollar-string price charged per paid call (USDC on the network's default stablecoin).
DIS_X402_PRICE=$0.01
# Facilitator that verifies and settles payments.
# Testnet default: https://x402.org/facilitator
# Mainnet: use a production facilitator (e.g. CDP) — see https://docs.x402.org
DIS_X402_FACILITATOR_URL=https://x402.org/facilitator
